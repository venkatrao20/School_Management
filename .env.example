PORT=5000
FRONTEND_URL=http://localhost:5173

# Railway MySQL exposes these variables on the linked service.
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=change-me
MYSQLDATABASE=school_management

# Railway may provide a complete connection URL instead of individual values.
# DATABASE_URL=mysql://user:password@host:3306/school_management
# MYSQL_URL=mysql://user:password@host:3306/school_management
JWT_ACCESS_SECRET=replace-with-a-long-random-secret

# Initial production administrator. These values are read only when the email
# does not already exist; use a distinct, strong password and store it only in
# Railway Variables, never in source control.
BOOTSTRAP_ADMIN_NAME=School Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-random-characters

# Development/demo only. Do not set this in Railway production.
SEED_DEMO_DATA=false

# Optional alternative accepted by mysql2.
# DATABASE_URL=mysql://user:password@host:3306/school_management
