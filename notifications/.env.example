SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
PORT=5001
VAPID_PUBLIC_KEY=generate-with-generate_vapid_keys.py
VAPID_PRIVATE_KEY=generate-with-generate_vapid_keys.py
VAPID_SUBJECT=mailto:notifications@example.com

# Shared MySQL contract for the future Node/Express notifications module.
# The current Flask runtime still uses SQLite and does not read these values.
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=change-me
MYSQLDATABASE=school_management
